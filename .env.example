# ==========================================================================
# AL AMR CLIPPING — Operator Environment Configuration Template (.env.example)
# ==========================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (Windows PowerShell)
# 2. Replace the placeholder values with your real production/staging credentials.
# 3. DO NOT commit your .env file to Git (verified in .gitignore).
# =========================================================================

# -----------------------------------------------------------------------------
# 1. Security & Master Encryption Key (Mandatory for Credential Vault)
# -----------------------------------------------------------------------------
# Primary master key used to derive AES-GCM 256-bit encryption keys for credential storage.
# Must be at least 32 characters long.
AL_AMR_MASTER_KEY=your_secure_random_passphrase_minimum_32_characters_long

# -----------------------------------------------------------------------------
# 2. Whop Campaign Discovery & Ingestion (Mandatory for Live Discovery)
# -----------------------------------------------------------------------------
# Creator Rewards API key from Whop dashboard (https://whop.com/developers).
WHOP_API_KEY=whop_prod_your_api_token_here
WHOP_BASE_URL=https://api.whop.com/v5

# ----------------------------------------------------------------------------
# 3. Telegram Escalation & Real-Time Human Alerting (Mandatory for Continuous Mode)
# -----------------------------------------------------------------------------
# Telegram Bot token generated via @BotFather.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_your_bot_token

# Telegram numeric Chat ID (personal or channel/group) to receive escalation alerts.
TELEGRAM_CHAT_ID=123456789

# Authorized operator Telegram User IDs (comma-separated).
TELEGRAM_ALLOWED_USER_IDS=123456789


# ----------------------------------------------------------------------------
# 4. YouTube Publishing Credentials (Optional if enrolled via POST /api/accounts)
# -----------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Client credentials with YouTube Data API v3 scope.
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=1//your_google_oauth_refresh_token
YOUTUBE_DEFAULT_PRIVACY=private

# ----------------------------------------------------------------------------
# 5. Instagram Publishing Credentials (Optional if enrolled via POST /api/accounts)
# ----------------------------------------------------------------------------
# Meta Graph API user or page access token with instagram_content_publish scope.
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ----------------------------------------------------------------------------
# 6. Storage & Execution Mode Overrides (Optional)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./project_vault
LOG_LEVEL=INFO
LOG_FORMAT=console
