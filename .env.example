# Clipping Automation Configuration

# Environment & Storage
ENVIRONMENT=development
PROJECT_VAULT_ROOT=./project_vault
DATABASE_URL=sqlite+aiosqlite:///./project_vault/clipping.db
STORAGE_DRIVER=local

# Google Drive Storage (Optional, for 5TB Vault)
# GOOGLE_DRIVE_FOLDER_ID=your_gdrive_folder_id
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gdrive_credentials.json

# Telegram Bot Governance (Required for Human Approval)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789
TELEGRAM_SECRET_TOKEN=optional_webhook_secret

# YouTube Data API v3 (Required for Publishing)
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secrets.json
YOUTUBE_CREDENTIALS_STORAGE_DIR=./secrets/youtube_tokens

# Local AI & Inference Settings
INFERENCE_DEVICE=auto
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
